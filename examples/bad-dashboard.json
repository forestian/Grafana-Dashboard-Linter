{
  "title": "Problematic Kubernetes Dashboard",
  "tags": [],
  "schemaVersion": 39,
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "query": "",
        "regex": ".*",
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prod-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "",
          "interval": "1s"
        }
      ]
    },
    {
      "id": 1,
      "title": "Broad Prometheus Query",
      "type": "timeseries",
      "fieldConfig": {
        "defaults": {}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prod-prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=~\".*\"}[10s]))"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pod Logs",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "prod-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\".*\"} |= \"error\""
        }
      ]
    },
    {
      "id": 4,
      "title": "Too Many Queries",
      "type": "stat",
      "targets": [
        { "refId": "A", "expr": "up" },
        { "refId": "B", "expr": "up" },
        { "refId": "C", "expr": "up" },
        { "refId": "D", "expr": "up" },
        { "refId": "E", "expr": "up" },
        { "refId": "F", "expr": "up" },
        { "refId": "G", "expr": "up" },
        { "refId": "H", "expr": "up" },
        { "refId": "I", "expr": "up" },
        { "refId": "J", "expr": "up" },
        { "refId": "K", "expr": "up" },
        { "refId": "L", "expr": "up" },
        { "refId": "M", "expr": "up" }
      ]
    }
  ]
}
